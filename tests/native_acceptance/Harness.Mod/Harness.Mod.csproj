<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Rwsi.NativeAcceptance</AssemblyName>
    <RootNamespace>Rwsi.NativeAcceptance</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <HarmonyReferencePath Condition="'$(HarmonyReferencePath)' == ''">$(MSBuildThisFileDirectory)../../../.superpowers/sdd/2026-10-17-complete-pawn-history/recorder-nuget-packages/lib.harmony/2.3.3/lib/net472/0Harmony.dll</HarmonyReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldNativeManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RimWorldNativeManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldNativeManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(HarmonyReferencePath)')">
      <HintPath>$(HarmonyReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="About/About.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LoadFolders.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
